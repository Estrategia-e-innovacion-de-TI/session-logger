{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": ".github/hooks/session-logger/session-logger.sh --event sessionStart",
        "powershell": ".github/hooks/session-logger/session-logger.sh --event sessionStart",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": ".github/hooks/session-logger/session-logger.sh --event userPromptSubmitted",
        "powershell": ".github/hooks/session-logger/session-logger.sh --event userPromptSubmitted",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": ".github/hooks/session-logger/session-logger.sh --event preToolUse",
        "powershell": ".github/hooks/session-logger/session-logger.sh --event preToolUse",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": ".github/hooks/session-logger/session-logger.sh --event postToolUse",
        "powershell": ".github/hooks/session-logger/session-logger.sh --event postToolUse",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": ".github/hooks/session-logger/session-logger.sh --event sessionEnd",
        "powershell": ".github/hooks/session-logger/session-logger.sh --event sessionEnd",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "bash": ".github/hooks/session-logger/session-logger.sh --event errorOccurred",
        "powershell": ".github/hooks/session-logger/session-logger.sh --event errorOccurred",
        "cwd": ".",
        "timeoutSec": 5
      }
    ]
  }
}

